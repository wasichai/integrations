# Wasichai Integrations example app: copy to .env (gitignored) and fill in. Both the api and the worker service read
# every variable, and compose reads them for ${...} in compose.yaml. Replace every replace-me: the app refuses to start
# on the placeholder JWT secret and encryption key, so it never runs on a shipped one. Full table:
# docs/guides/deployment.md. Never commit .env.

# --- image (compose only) -------------------------------------------------------------------------------------------
# the tag `docker compose build` writes and both services run; a registry image here skips the build
INTEGRATIONS_IMAGE=wasichai-integrations-app:local
# host port of the api service
API_PORT=8080

# --- database (wasichai core; compose sets WASICHAI_DB_HOST=postgres and WASICHAI_DB_PORT=5432) ---------------------
WASICHAI_DB_NAME=wasichai
WASICHAI_DB_USERNAME=wasichai
# openssl rand -hex 24
WASICHAI_DB_PASSWORD=replace-me

# --- sign-in (wasichai core) ----------------------------------------------------------------------------------------
# HS256 key of the platform's tokens, at least 32 bytes: openssl rand -base64 48
WASICHAI_JWT_SECRET=replace-me
# true seeds admin@wasichai.local / admin and a demo organization: local trials and the ci smoke test only, never
# anywhere reachable. without it, create the first organization and admin as wasichai's build-your-app guide says
WASICHAI_SEED_DEV=false
# browser origins the api answers (the ui's), comma separated
WASICHAI_WEB_CORSALLOWEDORIGINPATTERNS=http://localhost:*

# --- credential encryption (integrations, ADR-0005) -----------------------------------------------------------------
# one variable per key, WASICHAI_INTEGRATIONS_ENCRYPTION_KEYS_<ID>; the id in lowercase letters and digits only
# (a variable name cannot carry "-", and "_" separates levels). value: openssl rand -base64 32
# back the keys up with the database: a lost key makes every secret sealed with it unreadable for good
WASICHAI_INTEGRATIONS_ENCRYPTION_KEYS_K1=replace-me
# the key id new secrets are sealed with; one of the ids above
WASICHAI_INTEGRATIONS_ENCRYPTION_ACTIVEKEY=k1

# --- public url and oauth (integrations) ----------------------------------------------------------------------------
# how providers reach this app (oauth callback, webhooks); https in production
WASICHAI_INTEGRATIONS_PUBLICBASEURL=http://localhost:8080
# where the browser lands after a provider's consent: the ui's connections page
WASICHAI_INTEGRATIONS_OAUTH_RETURNURL=http://localhost:5173/integrations/connections

# --- connectors (this app: app.connectors.*) ------------------------------------------------------------------------
# every shipped connector is on; false leaves it out of the catalog
APP_CONNECTORS_NOTION_ENABLED=true
APP_CONNECTORS_SALESFORCE_ENABLED=true
APP_CONNECTORS_JIRA_ENABLED=true
APP_CONNECTORS_GITHUB_ENABLED=true
APP_CONNECTORS_SLACK_ENABLED=true
# salesforce: https://test.salesforce.com for sandboxes, or a My Domain url
APP_CONNECTORS_SALESFORCE_LOGINURL=https://login.salesforce.com
# a fixed REST API version (66.0); empty takes the instance's newest
APP_CONNECTORS_SALESFORCE_APIVERSION=
# change data capture instead of polling for some objects (ADR-0024), e.g.
# Account=/data/AccountChangeEvent,Contact=/data/ContactChangeEvent. empty: every object is polled
APP_CONNECTORS_SALESFORCE_CDCCHANNELS=
# jira: the site of API token connections (https://acme.atlassian.net); empty allows OAuth connections only
APP_CONNECTORS_JIRA_SITEURL=
# jira: pins one site (its cloud id, a uuid) when an OAuth grant reaches several; empty takes the only one
APP_CONNECTORS_JIRA_CLOUDID=
# github: GitHub Enterprise Server is https://ghe.example.com and https://ghe.example.com/api/v3
APP_CONNECTORS_GITHUB_WEBURL=https://github.com
APP_CONNECTORS_GITHUB_APIURL=https://api.github.com

# --- runtime --------------------------------------------------------------------------------------------------------
# behind a reverse proxy: framework (client address and scheme from the forwarded headers)
SERVER_FORWARDHEADERSSTRATEGY=none
# extra jvm flags; the image already sizes the heap to 75% of the container's memory
JAVA_TOOL_OPTIONS=
