{
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "files": ["index.ts", "program.ts", "settings.ts"],
    "include": ["test/**/*.ts"]
}
